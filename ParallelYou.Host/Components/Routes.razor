<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="[typeof(ParallelYou.Web.Components.Pages.Home).Assembly]">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized><p>Please <a href="/account/login">sign in</a> to open your workspace.</p></NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound><LayoutView Layout="typeof(MainLayout)"><h1>Page not found</h1></LayoutView></NotFound>
</Router>
